# Copy this file to .env and add your own keys locally. Never commit .env.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: improves web search and extraction; DuckDuckGo fallback is used without it.
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: raises GitHub API rate limits.
GITHUB_TOKEN=
